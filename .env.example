# Set these as Netlify site environment variables; `netlify dev` pulls them once the folder is linked
# (`netlify link`). A .env.local with the same names also works for local dev.

# Client, injected at build: Supabase auth (get-llm-token edge function mints the chat-role JWT)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable or anon key>

# Server only, read by netlify/functions/chat.mts
GEMINI_API_KEY=<google ai studio key>
