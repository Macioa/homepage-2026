# Set these as Netlify site environment variables; `netlify dev` pulls them once the folder is linked
# (`netlify link`). A .env.local with the same names also works for local dev.

# Client, injected at build: Supabase auth (get-jwt edge function mints the chat-role JWT)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable or anon key>

# Server only, read by netlify/functions/chat.mts
GEMINI_API_KEY=<google ai studio key>
# Server only, read by netlify/functions/get-jwt.mts; same value as the get-jwt edge function's JWT_PROXY_SECRET
JWT_PROXY_SECRET=<random string>

# Local dev only: netlify dev port (Vite on DEV_PORT + 1); add http://localhost:<DEV_PORT> to get-jwt's allowed origins
DEV_PORT=48317


# Sentry (optional; telemetry is off when unset). Browser DSN injected at build; server DSN read by netlify/sentry.ts
VITE_SENTRY_DSN=<sentry dsn>
SENTRY_DSN=<sentry dsn>
# Grafana Cloud OTLP (optional), read by netlify/sentry.ts: the stack's OTLP URL, and Authorization=Basic <base64 of instanceId:token> (space as %20)
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64>
# Build only (Netlify): Sentry org auth token for source map upload; never commit
SENTRY_AUTH_TOKEN=<sntrys_...>
